# Automatic HTTPS for $DOMAIN (Let's Encrypt). With DOMAIN=localhost Caddy serves a local cert.
{$DOMAIN:localhost} {
	encode zstd gzip

	# API + local staging site go straight to FastAPI; flush immediately so SSE progress streams.
	@api path /api/* /site/*
	handle @api {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	log {
		output stdout
		format json
	}
}
