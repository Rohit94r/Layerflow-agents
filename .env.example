# LayerFlow agent engine — copy to .env and fill in. Never commit .env.
# Every variable is documented in plan.md Appendix A and docs/runbook.md.

# ---- Core ----
APP_ENV=production
# 32+ random characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
APP_BASE_URL=https://agents.example.com
DOMAIN=agents.example.com
TENANT_DEFAULT=ten
LOG_LEVEL=info

# First admin (applied by bootstrap only when no users exist yet). Password: 10+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Database ----
POSTGRES_USER=layerflow
POSTGRES_PASSWORD=
POSTGRES_DB=layerflow
# docker-compose builds DATABASE_URL from the three values above. For local dev without Docker:
# DATABASE_URL=sqlite+aiosqlite:///./data/dev.db

# ---- Model (no paid API keys) ----
# ollama | openai_compat | mock   (mock = deterministic extractive output for UI work; labelled in the UI)
MODEL_PROVIDER=ollama
# Compose runs Ollama when COMPOSE_PROFILES includes local-model. For a model on another machine over
# Tailscale, remove local-model and set e.g. OLLAMA_BASE_URL=http://100.x.y.z:11434
COMPOSE_PROFILES=local-model
OLLAMA_BASE_URL=http://ollama:11434
MODEL_WRITER=qwen2.5:7b-instruct
MODEL_FAST=qwen2.5:3b-instruct
MODEL_EMBED=nomic-embed-text
MODEL_TIMEOUT_S=600
MODEL_CONCURRENCY=1
MODEL_NUM_CTX=8192
# Optional free-tier / self-hosted OpenAI-compatible endpoint (MODEL_PROVIDER=openai_compat)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# ---- Discovery / fetching ----
FETCH_USER_AGENT=LayerFlowBot/1.0 (+https://theexecutivenarrative.com; contact@theexecutivenarrative.com)
FETCH_MAX_PER_DOMAIN=1
FETCH_CACHE_DAYS=7

# ---- Publishing ----
# export | ten_static | wordpress | webhook   (export bundle is always produced as a backup)
PUBLISH_TARGET=export
TEN_SITE_URL=https://theexecutivenarrative.com
# Leave TEN_SFTP_HOST empty to publish ten_static pages to the local staging site (/site/<tenant>/…)
TEN_SFTP_HOST=
TEN_SFTP_PORT=22
TEN_SFTP_USER=
TEN_SFTP_KEY_PATH=
TEN_PUBLIC_ROOT=/public_html
WORDPRESS_URL=
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=
WEBHOOK_URL=
WEBHOOK_SECRET=

# ---- LinkedIn (optional; official API only) ----
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# defaults to $APP_BASE_URL/api/v1/settings/integrations/linkedin/callback
LINKEDIN_REDIRECT_URI=
LINKEDIN_ORG_URN=
LINKEDIN_API_VERSION=202606
# Fernet key for tokens at rest:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---- Ops ----
BACKUP_KEEP=14
BACKUP_RCLONE_REMOTE=
ALERT_WEBHOOK_URL=
DISK_ALERT_PCT=85
RATE_LIMIT_MUTATIONS_PER_MIN=60
RATE_LIMIT_READS_PER_MIN=600
