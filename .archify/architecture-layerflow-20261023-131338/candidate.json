  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime & access",
      "items": [
        "Next.js calls same-origin /api/v1 with an HTTP-only session cookie and a CSRF header.",
        "FastAPI owns authentication, tenant scoping, CRUD, and SSE streams for jobs and article events.",
        "Caddy terminates TLS; /api/* and /site/* go straight to FastAPI while all other paths reach the web container."
      ]
    },
    {
      "dot": "emerald",
      "title": "Agent pipeline",
      "items": [
        "Stages run in order: research → write → edit → seo → qa, then human review, approval, scheduling and publishing.",
        "The orchestrator validates every state transition; QA can send work back to write or edit, capped by quality.max_revisions (default 2).",
        "Each stage is a queued job; failures retry with backoff or move the article to failed / needs_sources."
      ]
    },
    {
      "dot": "amber",
      "title": "Discovery & evidence",
      "items": [
        "Active sources are RSS feeds or syndication APIs, fetched through one guarded Fetcher with SSRF checks, robots.txt and per-domain pacing.",
        "Discovery normalises URLs, filters non-English and avoided topics, clusters duplicates, then scores and enriches the strongest stories.",
        "Research assembles a grounded source pack; the critic blocks an article when grounding is insufficient."
      ]
    },
    {
      "dot": "violet",
      "title": "Deployment & operations",
      "items": [
        "Docker Compose runs Caddy, web, API, worker and PostgreSQL 16; Ollama is an optional local-model profile.",
        "The worker runs one model lane and two IO lanes; housekeeping recovers stale jobs, schedules discovery, checks model/disk health and applies retention.",
        "Artifacts, fetch cache, staged site and backups are named volumes; only Caddy publishes ports."
      ]
    }
  ]
